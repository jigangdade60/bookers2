<div class="container mt-4">
  <div class="row">
    <div class="col-md-3">
      <%= render "layouts/sidebar", user: @user, book: @book_new, context: "user_show" %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Book detail</h2>

      <table class="table align-middle">
        <tbody>
          <tr>
            <td style="width: 140px;">
              <div class="d-flex align-items-center justify-content-center">
                <%= profile_image_tag(@book.user, size: 100) %>
              </div>
              <div class="mt-2">
                <%= link_to @book.user.name, user_path(@book.user), class: "text-decoration-none fw-bold" %>
              </div>
            </td>

            <td style="width: 35%;">
              <%= @book.title %>
            </td>

            <td>
              <%= @book.body %>
            </td>

            <% if @book.user == current_user %>
              <td class="text-end" style="width: 180px;">
                <%= link_to "Edit", edit_book_path(@book), class: "btn btn-success btn-sm" %>
                <%= link_to "Destroy", book_path(@book),
                            data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
                            class: "btn btn-danger btn-sm ms-2" %>
              </td>
            <% end %>
             <% if @book.favorited_by?(Current.user) %>
             <p>
             <%= link_to book_favorite_path(@book), data: { turbo_method: :delete } do %>
             ♥<%= @book.favorites.count %> いいね
             <% end %>
             </p>
             <% else %>
             <p>
             <%= link_to book_favorite_path(@book), data: { turbo_method: "post" } do %>
             ♡<%= @book.favorites.count %> いいね
             <% end %>
             </p>
             <% end %>

             <td>
             <p>コメント件数：<%= @book.book_comments.count %></p>
             <% @book.book_comments.each do |book_comment| %>
             <p><%= image_tag book_comment.user.get_profile_image(100,100) %></p>
             <%= book_comment.user.name %>
             <%= book_comment.created_at.strftime('%Y/%m/%d') %><%= book_comment.comment %>
             <% if book_comment.user == current_user %>
             <%= link_to "削除", book_book_comment_path(book_comment.book, book_comment), data: { turbo_method: :delete } %>
             <% end %>
             <% end %>
             </td>
             <td>
             <%= form_with model: [@book, @book_comment] do |f| %>
             <%= f.text_area :comment, rows: '5', placeholder: "コメントをここに" %>
             <%= f.submit "送信する" %>
             <% end %>
             </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
