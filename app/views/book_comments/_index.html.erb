<table>
  <tbody>
    <% book.book_comments.each do |book_comment| %>
      <tr>        
        <td>
          <%= link_to user_path(book_comment.user), data: { turbo_frame: "_top" } do %>
            <%= image_tag book_comment.user.get_profile_image(32,32), size: "32x32" %><br>
            <%= book_comment.user.name %>
          <% end %>
        </td>
        <td><%= book_comment.comment %></td>
        <td>
          <% if book_comment.user == Current.user %>
            <%= link_to "Destroy", book_book_comment_path(book, book_comment),data: { turbo_method: :delete, turbo_confirm: '本当に消しますか？' }, class: "btn btn-danger pull-right", remote: true %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>