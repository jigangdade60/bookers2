<div class='container px-5 px-sm-0'>
  <div class='row'>
    <div class='col-md-3'>
      <h2>User info</h2>
      <%= render '/users/info', user: @user %>
    </div>
    <div class='col-md-8 offset-md-1'>
      <h2>Follow Users</h2>
      <% if @followings.exists? %>
        <%= render '/users/index', users: @followings %>
      <% else %>
        <p>ユーザーはいません</p>
      <% end %>
    </div>
  </div>
</div>
